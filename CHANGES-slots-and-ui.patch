@@ -0,0 +1,38 @@
+'use client';
+import {useEffect,useState} from 'react';
+import type {EventAvailability} from '@/lib/availability';
+
+/** Keeps slot counts fresh: polls while the tab is visible and refreshes when the tab regains focus. */
+export function useAvailability(slug:string,initial:EventAvailability,intervalMs=15000){
+ const[data,setData]=useState<EventAvailability>(initial);
+ const[stale,setStale]=useState(false);
+ useEffect(()=>{
+  let alive=true,timer:ReturnType<typeof setTimeout>|undefined;
+  async function load(){
+   try{
+    const r=await fetch('/api/availability?event='+encodeURIComponent(slug),{cache:'no-store'});
+    if(!r.ok)throw new Error('bad status');
+    const next=await r.json() as EventAvailability;
+    if(alive){setData(next);setStale(false)}
+   }catch{if(alive)setStale(true)}
+  }
+  function schedule(){timer=setTimeout(async()=>{if(document.visibilityState==='visible')await load();if(alive)schedule()},intervalMs)}
+  const onVisible=()=>{if(document.visibilityState==='visible')load()};
+  document.addEventListener('visibilitychange',onVisible);window.addEventListener('focus',onVisible);
+  load();schedule();
+  return()=>{alive=false;if(timer)clearTimeout(timer);document.removeEventListener('visibilitychange',onVisible);window.removeEventListener('focus',onVisible)};
+ },[slug,intervalMs]);
+ return {data,stale,refresh:async()=>{try{const r=await fetch('/api/availability?event='+encodeURIComponent(slug),{cache:'no-store'});if(r.ok){setData(await r.json());setStale(false)}}catch{setStale(true)}}};
+}
+
+export function slotsText(remaining:number,capacity:number){
+ if(capacity>0&&remaining<=0)return 'Sold out';
+ return remaining+(remaining===1?' slot':' slots')+' remaining';
+}
+
+/** Slots-remaining label for a race card. */
+export default function LiveSlots({slug,initial}:{slug:string;initial:EventAvailability}){
+ const{data}=useAvailability(slug,initial);
+ const low=data.capacity>0&&data.remaining>0&&data.remaining/data.capacity<=.2,out=data.capacity>0&&data.remaining<=0;
+ return <small className={'slots'+(out?' slots-out':low?' slots-low':'')} aria-live="polite">{slotsText(data.remaining,data.capacity)}</small>;
+}
