new file mode 100644
index 0000000..775564a
--- /dev/null
+++ b/app/api/availability/route.ts
@@ -0,0 +1,18 @@
+import {event} from '@/lib/server';
+import {availability} from '@/lib/availability';
+import {DEFAULT_EVENT} from '@/lib/event-types';
+
+export const dynamic='force-dynamic';
+
+// Public, read-only slot counts used by the live "slots remaining" badges.
+export async function GET(req:Request){
+ try{
+  const slug=new URL(req.url).searchParams.get('event')||DEFAULT_EVENT;
+  const ev=await event(slug);
+  if(!ev||!ev.published)return Response.json({error:'Event not found.'},{status:404,headers:{'Cache-Control':'no-store'}});
+  return Response.json(await availability(ev),{headers:{'Cache-Control':'no-store'}});
+ }catch(e){
+  console.error(e);
+  return Response.json({error:'Unable to load availability.'},{status:503,headers:{'Cache-Control':'no-store'}});
+ }
+}
