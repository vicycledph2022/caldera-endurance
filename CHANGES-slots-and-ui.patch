@@ -0,0 +1,16 @@
+import {db} from '@/lib/server';
+import {eventCategories,type EventConfig} from '@/lib/event-types';
+
+export type CategoryAvailability={id:string;distance:string;capacity:number;taken:number;remaining:number};
+export type EventAvailability={slug:string;capacity:number;taken:number;remaining:number;full:boolean;categories:CategoryAvailability[]};
+
+/** Live slot counts. Mirrors the capacity check in /api/data (per category), so the number shown is the number the server enforces. */
+export async function availability(ev:EventConfig):Promise<EventAvailability>{
+ const cats=eventCategories(ev);
+ const rows=await db().prepare('SELECT category_id, COUNT(*)::int AS count FROM registrations WHERE event_id=? GROUP BY category_id').bind(ev.slug).all<{category_id:string|null;count:number}>();
+ const byId=new Map<string,number>(),total=rows.results.reduce((n,r)=>n+Number(r.count||0),0);
+ for(const r of rows.results)byId.set(String(r.category_id??''),Number(r.count||0));
+ const categories=cats.map(c=>{const taken=cats.length===1?total:(byId.get(c.id)||0);return {id:c.id,distance:c.distance,capacity:c.capacity,taken,remaining:Math.max(0,c.capacity-taken)}});
+ const capacity=categories.reduce((n,c)=>n+c.capacity,0),remaining=categories.reduce((n,c)=>n+c.remaining,0);
+ return {slug:ev.slug,capacity,taken:capacity-remaining,remaining,full:capacity>0&&remaining===0,categories};
+}
